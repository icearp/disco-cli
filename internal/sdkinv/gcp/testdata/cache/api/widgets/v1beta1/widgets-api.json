{
  "name": "widgets", "version": "v1beta1",
  "resources": {
    "projects": {"resources": {"locations": {"resources": {
      "widgets": {"methods": {
        "list": {"path": "v1beta1/{+parent}/widgets", "httpMethod": "GET", "parameters": {"parent": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+$"}}},
        "create": {"path": "v1beta1/{+parent}/widgets", "httpMethod": "POST", "parameters": {"parent": {"required": true, "location": "path"}}}
      }},
      "gadgets": {"methods": {
        "list": {"path": "v1beta1/{+parent}/gadgets", "httpMethod": "GET", "parameters": {"parent": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+$"}}},
        "create": {"path": "v1beta1/{+parent}/gadgets", "httpMethod": "POST", "parameters": {"parent": {"required": true, "location": "path"}}}
      }}
    }}}}
  }
}
