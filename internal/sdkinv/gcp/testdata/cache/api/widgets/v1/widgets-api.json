{
  "name": "widgets", "version": "v1",
  "resources": {
    "projects": {"resources": {"locations": {"resources": {
      "widgets": {
        "methods": {
          "list":   {"path": "v1/{+parent}/widgets", "httpMethod": "GET", "parameters": {"parent": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+$"}, "pageToken": {"location": "query"}}},
          "get":    {"path": "v1/{+name}", "httpMethod": "GET", "parameters": {"name": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+/widgets/[^/]+$"}}},
          "create": {"path": "v1/{+parent}/widgets", "httpMethod": "POST", "parameters": {"parent": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+$"}}},
          "delete": {"path": "v1/{+name}", "httpMethod": "DELETE", "parameters": {"name": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+/widgets/[^/]+$"}}}
        },
        "resources": {
          "parts": {"methods": {
            "list": {"path": "v1/{+parent}/parts", "httpMethod": "GET", "parameters": {"parent": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+/widgets/[^/]+$"}}},
            "get":  {"path": "v1/{+name}", "httpMethod": "GET", "parameters": {"name": {"required": true, "location": "path"}}},
            "create": {"path": "v1/{+parent}/parts", "httpMethod": "POST", "parameters": {"parent": {"required": true, "location": "path"}}}
          }}
        }
      },
      "operations": {"methods": {
        "list": {"path": "v1/{+name}/operations", "httpMethod": "GET", "parameters": {"name": {"required": true, "location": "path", "pattern": "^projects/[^/]+/locations/[^/]+$"}}},
        "get": {"path": "v1/{+name}", "httpMethod": "GET", "parameters": {"name": {"required": true, "location": "path"}}, "response": {"$ref": "Operation"}},
        "cancel": {"path": "v1/{+name}:cancel", "httpMethod": "POST", "parameters": {"name": {"required": true, "location": "path"}}},
        "delete": {"path": "v1/{+name}", "httpMethod": "DELETE", "parameters": {"name": {"required": true, "location": "path"}}}
      }}
    }}}},
    "zones": {"methods": {
      "list": {"path": "projects/{project}/zones", "flatPath": "projects/{project}/zones", "httpMethod": "GET", "parameters": {"project": {"required": true, "location": "path"}}},
      "get":  {"path": "projects/{project}/zones/{zone}", "httpMethod": "GET", "parameters": {"project": {"required": true, "location": "path"}, "zone": {"required": true, "location": "path"}}}
    }},
    "gizmos": {"methods": {
      "aggregatedList": {"path": "projects/{project}/aggregated/gizmos", "flatPath": "projects/{project}/aggregated/gizmos", "httpMethod": "GET", "parameters": {"project": {"required": true, "location": "path"}}},
      "list": {"path": "projects/{project}/zones/{zone}/gizmos", "flatPath": "projects/{project}/zones/{zone}/gizmos", "httpMethod": "GET", "parameters": {"project": {"required": true, "location": "path"}, "zone": {"required": true, "location": "path"}}},
      "insert": {"path": "projects/{project}/zones/{zone}/gizmos", "httpMethod": "POST", "parameters": {}}
    }},
    "buckets": {"methods": {
      "list": {"path": "b", "httpMethod": "GET", "parameters": {"project": {"required": true, "location": "query"}}},
      "insert": {"path": "b", "httpMethod": "POST", "parameters": {}}
    }},
    "notifications": {"methods": {
      "list": {"path": "b/{bucket}/notificationConfigs", "httpMethod": "GET", "parameters": {"bucket": {"required": true, "location": "path"}}},
      "insert": {"path": "b/{bucket}/notificationConfigs", "httpMethod": "POST", "parameters": {"bucket": {"required": true, "location": "path"}}}
    }}
  }
}
