      }
     }
    },
    "insert": {
     "path": "b",
     "httpMethod": "POST",
     "parameters": {}
    }
   }
  },
  "notifications": {
   "methods": {
    "list": {
     "path": "b/{bucket}/notificationConfigs",
     "httpMethod": "GET",
     "parameters": {
