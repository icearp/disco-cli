   "resources": {
    "locations": {
     "resources": {
      "widgets": {
       "methods": {
        "list": {
         "path": "v1/{+parent}/widgets",
         "httpMethod": "GET",
         "parameters": {
          "parent": {
           "required": true,
           "location": "path",
           "pattern": "^projects/[^/]+/locations/[^/]+$"
          },
          "pageToken": {
           "location": "query"
          }
         },
         "response": {
          "$ref": "ListWidgetsResponse"
         }
        },
        "get": {
         "path": "v1/{+name}",
         "httpMethod": "GET",
