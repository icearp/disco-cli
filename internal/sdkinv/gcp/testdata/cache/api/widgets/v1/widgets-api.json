 },
 "schemas": {
  "ListWidgetsResponse": {
   "type": "object",
   "properties": {
    "widgets": {
     "type": "array",
     "items": {
      "$ref": "Widget"
     }
    },
    "nextPageToken": {
     "type": "string"
    }
   }
  },
  "Widget": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "description": "Identifier. The resource name of the widget."
    },
    "network": {
     "type": "string",
     "description": "URL of the VPC network the widget attaches to."
    },
    "serviceAccount": {
     "type": "string",
     "description": "Email address of the IAM service account the widget runs as."
    },
    "displayName": {
     "type": "string",
     "description": "Human readable label."
    },
    "sizing": {
     "$ref": "WidgetSizing"
    }
   }
  },
  "WidgetSizing": {
   "type": "object",
   "properties": {
    "machineType": {
     "type": "string",
     "description": "Full or partial URL of the machine type."
    },
    "cpus": {
     "type": "integer"
    }
   }
  },
  "Operation": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    }
   }
  }
 }
}